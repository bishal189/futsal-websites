# Kanakai Futsal environment settings
# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit real passwords.

# "development" on your machine, "production" on the live server.
# Production turns DEBUG off.
DJANGO_ENV=development

# Comma-separated domains the site answers to.
# Development: localhost,127.0.0.1
# Production:  kanakaifutsal.com,www.kanakaifutsal.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Who gets owner alerts for new bookings and cancellations (comma-separated).
OWNER_NOTIFICATION_EMAILS=shreeshacademy@gmail.com,mohannthapa@gmail.com

# Email login for sending booking emails (kept here so it is never committed).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
